            <feTurbulence id="rippleTurb" type="fractalNoise" baseFrequency="0.015 0.04" numOctaves="4" seed="3" result="noise"></feTurbulence>
            <feDisplacementMap id="rippleDisp" in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
          </filter>
        </defs>
      </svg>
      <div class="hero-text">
        <p class="name-tag">신미경 — Product Engineer</p>
        <h1 class="display"><span class="line">제품의 로직과 UX를</span> <span class="line">설계하고,</span> <span class="line">직접 만듭니다.</span></h1>
        <p class="sub">10년 UI/UX 위에 프론트엔드·AI를 얹어, <br>문제 정의부터 화면 구현·배포까지 빠르게 만들고 개선합니다.</p>
        <div class="row">
          <a href={`${base}work`} class="btn btn-primary">작업 보기</a>
        </div>
      </div>
    </section>
  </div>

  <section class="stats" aria-label="주요 성과">
    <div class="wrap">
      <div class="grid">
        <div>
          <p class="stat-num">10년</p>
          <p class="stat-label">UI/UX 화면설계</p>
        </div>
        <div>
          <p class="stat-num">23건</p>
          <p class="stat-label">참여 프로젝트</p>
        </div>
        <div>
          <p class="stat-num">2종</p>
          <p class="stat-label">직접 만든 결과물</p>
        </div>
        <div>
          <p class="stat-num">7년</p>
          <p class="stat-label">IT 교육·멘토링</p>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="cases">
      <span class="kicker">PRODUCT</span>
      <div class="case-grid">
        <a href={`${base}case-mdtofigma`} class="case-card">
          <span class="card-kicker">Product · Figma Plugin</span>
          <h2 class="card-title">MD to Figma — 마크다운 ⇄ Figma 양방향 엔진</h2>
          <p class="card-body">실제 설치·사용 가능한 Figma 커뮤니티 배포 플러그인.</p>
          <div class="card-tags">
            <span class="tag tag-accent">Figma Plugin API</span>
            <span class="tag tag-neutral">ES6</span>
          </div>
        </a>
        <a href={`${base}case-modu`} class="case-card">
          <span class="card-kicker">Prototype · React</span>
          <h2 class="card-title">Mod U · 모두의 시간</h2>
          <p class="card-body">'침묵=동의' 규칙을 상태머신으로 구현한 회의 조율 프로토타입.</p>
          <div class="card-tags">
            <span class="tag tag-accent">React · Vite</span>
            <span class="tag tag-neutral">상태머신</span>
          </div>
        </a>
        <a href={`${base}about`} class="case-card">
          <span class="card-kicker">Enterprise UX</span>
          <h2 class="card-title">현업 10년 — 대형 B2B/B2G 화면설계</h2>
          <p class="card-body">KT 기간망·소방방재청 긴급구조 GIS 등 복잡한 시스템의 UI/UX·화면설계·정보구조.</p>
          <div class="card-tags">
            <span class="tag tag-accent">UI/UX 10년</span>
            <span class="tag tag-neutral">화면설계</span>
          </div>
        </a>
      </div>
    </section>

    <hr class="rule" />

    <section class="skills">
      <span class="kicker">Skills</span>
      <div class="skill-grid">
        <div class="skill-col">
          <h3>Build</h3>
          <p>ECMAScript·HTML/CSS 기반 · React · Vue · Flutter(학습) · REST API·비동기 처리 · Git/GitHub · GitHub Actions·Pages 배포</p>
        </div>
        <div class="skill-col">
          <h3>Design</h3>
          <p>UX 리서치 · 유저 플로우 설계 · Figma(컴포넌트·오토레이아웃·플러그인) · 디자인 시스템</p>
        </div>
        <div class="skill-col">
          <h3>AI</h3>
          <p>ChatGPT · Claude · Cursor — 프롬프트 기반 리서치·설계·구현 워크플로우</p>
        </div>
        <div class="skill-col">
          <h3>Domain</h3>
          <p>대형 B2B/B2G 시스템 화면설계 (통신망·재난 GIS, 23개 프로젝트) · 복잡한 데이터·상태 흐름 구조화 · 제품 데이터 분석 개념(GA4·Amplitude·MMP) 학습·교안화</p>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="about-teaser">
      <span class="kicker">About</span>
      <p class="lead">가르치는 것을 넘어, 직접 만듭니다.</p>
      <p class="excerpt">10년간 대형 서비스의 UI/UX를 설계했고, 최근엔 문제 정의부터 로직 설계·프론트엔드 구현·배포까지 직접 해왔습니다. <br>비주얼 중심 화면 구현보다 '왜 이렇게 동작하는가'의 인과관계를 설계하는 일을 좋아합니다.</p>
      <a href={`${base}about`} class="btn btn-primary">About 더 보기</a>
    </section>

    <hr class="rule" />

    <section class="site-footer" id="contact">
      <div class="footer-inner footer-inner--full">
        <div class="footer-contact">
          <h3>함께 만들 준비가 되어 있습니다</h3>
          <p>채용·협업·프로젝트 제안이 있으시다면 언제든 연락해 주세요.</p>
          <div class="footer-links">
            <a href="mailto:runa.uxlabs@gmail.com" class="btn btn-primary">runa.uxlabs@gmail.com</a>
            <a href="https://www.linkedin.com/in/runauxlabs/" target="_blank" rel="noopener" class="btn btn-secondary">LinkedIn</a>
            <a href="https://github.com/RunaUXLabs" target="_blank" rel="noopener" class="btn btn-secondary">GitHub</a>
          </div>
        </div>
        <p class="footer-copy">© 2026 RunaUXLabs — Product Engineer</p>
      </div>
    </section>
  </div>
</Base>

<script>
  // 히어로 배경 로고의 물결(ripple) 인터랙션 — 순수 JS(번들됨, 외부 런타임 없음).
  const svg = document.getElementById('heroLogo');
  const turb = document.getElementById('rippleTurb');
  const disp = document.getElementById('rippleDisp');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (svg && turb && disp && !reduce) {
    let ripple = 0; // 이벤트로 튀어오르고, 매 프레임 감쇠
    let t = 0;
    const tick = () => {
      t += 0.003;
      // 은은한 상시 흔들림(ambient) + 상호작용 진폭(ripple)
      turb.setAttribute('baseFrequency', `${0.015 + Math.sin(t) * 0.005} ${0.02 + Math.cos(t * 1.3) * 0.005}`);
      const base = 0.8 + Math.sin(t * 2) * 0.4;
      disp.setAttribute('scale', String(base + ripple));
      ripple *= 0.92; // 감쇠
      if (ripple < 0.01) ripple = 0;
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    svg.addEventListener('mouseenter', () => { ripple = Math.max(ripple, 12); });
    svg.addEventListener('mousemove', (e) => {
      const r = svg.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width;
      const y = (e.clientY - r.top) / r.height;
      turb.setAttribute('seed', String(Math.floor(x * 100 + y * 100)));
      if (ripple < 3) ripple = 3;
    });
    svg.addEventListener('click', () => { ripple = 25; });
  }
</script>